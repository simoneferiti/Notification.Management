<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Notification.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Notification.UI"
    xmlns:converters="using:Notification.UI.Converters">


    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrushConverter" />

            <SolidColorBrush x:Key="PriorityLowBrush" Color="#DDEEDD" />
            <SolidColorBrush x:Key="PriorityMediumBrush" Color="#FFF4CC" />
            <SolidColorBrush x:Key="PriorityHighBrush" Color="#FFD9B3" />
            <SolidColorBrush x:Key="PriorityCriticalBrush" Color="#FFC2C2" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
